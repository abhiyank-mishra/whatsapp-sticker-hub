{
  "manifest_version": 3,
  "name": "WhatsApp Sticker Hub - Custom Stickers Manager",
  "version": "2.0.0",
  "description": "Manage, organize, auto-save incoming stickers, import from Sticker.ly or web, and 1-click send native stickers in WhatsApp Web.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://sticker.ly/*",
    "https://*.pstatic.net/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WhatsApp Sticker Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "inject/wa-sticker-api.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/default-stickers.js",
        "shared/storage.js",
        "shared/smart-reply.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject/wa-sticker-api.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
